APP_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=https://asset.mcj.life
# Keep this stable across restarts and restores; it is a non-secret instance name.
LEDGER_INSTANCE_ID=asset-nas
LEDGER_ID=main
# Optional migration alias: old /api/session accountId hash. No Feishu secrets on NAS.
LEGACY_ACCOUNT_ID=
# Use asset_app with readWrite on asset only. URI password must be URL-encoded.
# In NAS Docker, use host mongodb-asset, database asset and authSource=asset.
MONGODB_URI=
MONGODB_DATABASE=asset
NAS_IP=192.168.1.107
ASSET_PORT=8092
PORT=3000
