{
  "name": "assetmanager-desktop",
  "version": "2.0.8",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "node desktop/build.mjs",
    "start": "node desktop/node_modules/electron/cli.js desktop",
    "package": "npm run build && node desktop/package-app.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test desktop/tests/nas-cache.test.mjs desktop/tests/nas-credentials.test.mjs desktop/tests/nas-desktop.test.mjs desktop/tests/nas-package.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.27.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
